# Backend origin for the DEPLOYED frontend.
# Local dev: leave empty — Vite's proxy forwards /api -> http://127.0.0.1:8010.
# Production (Vercel): set this to your backend's public origin, no trailing slash.
#   e.g. VITE_API_BASE=https://yourname.ngrok-free.app
#   or   VITE_API_BASE=https://your-space.hf.space
VITE_API_BASE=
